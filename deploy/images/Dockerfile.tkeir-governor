# Thin image on shared tkeir-lib (bake/compose named context).
# syntax=docker/dockerfile:1.4
FROM tkeir-lib

ARG VERSION=0.0.0-dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

USER root
ENV TKEIR_SERVICE=tkeir-governor \
    GOVERNOR_HOST=0.0.0.0 \
    GOVERNOR_PORT=8094 \
    GOVERNOR_STATE_ROOT=/var/tkeir/governor \
    GOVERNOR_MODE=observe

RUN mkdir -p /var/tkeir/governor \
    && chown -R 10001:10001 /var/tkeir/governor

USER 10001
EXPOSE 8094

LABEL org.opencontainers.image.title="tkeir-governor" \
      org.opencontainers.image.description="T-KEIR runtime governor (enforce, budgets, kill switch)" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}"

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${GOVERNOR_PORT}/health" || exit 1

ENTRYPOINT ["tkeir-governor"]
