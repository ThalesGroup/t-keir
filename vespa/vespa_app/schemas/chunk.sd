
# Generated from tkeir/configs/rag.yaml via `make schemas`.
# DO NOT hand-edit — change rag.yaml and regenerate.
# Source: scripts/generate_vespa_schemas.py
schema chunk {
    document chunk {
        field user_space type string {
            indexing: summary | attribute
        }
        field chunk_id type string {
            indexing: summary | attribute
        }
        # Parent id string (same streaming group). Join key for document arm.
        field doc_ref type string {
            indexing: summary | attribute
        }
        # Denormalized parent key for RRF fusion without an extra fetch.
        field source_doc_id type string {
            indexing: summary | attribute
        }
        field text_raw type string {
            indexing: summary | index
            index: enable-bm25
        }
        # Streaming mode: exact nearestNeighbor (no HNSW index).
        field chunk_embedding type tensor<float>(x[384]) {
            indexing: attribute
            attribute { distance-metric: angular }
        }
        field questions_embeddings type tensor<float>(q{}, x[384]) {
            indexing: attribute
            attribute { distance-metric: angular }
        }
    }

    fieldset default {
        fields: text_raw
    }


    # Balanced hybrid (default). Weights from rag.yaml rank_profiles.chunk.
    rank-profile hybrid_2_level {
        inputs {
            query(q_chunk_emb) tensor<float>(x[384])
            query(q_question_emb) tensor<float>(x[384])
        }
        rank-properties {
            bm25(text_raw).averageFieldLength: 180
        }
        first-phase {
            expression {
                closeness(field, chunk_embedding) * 0.45 +
                closeness(field, questions_embeddings) * 0.2 +
                bm25(text_raw) * 0.35
            }
        }
        second-phase {
            expression: firstPhase
            rerank-count: 50
        }
    }



    # Semantic-heavy profile.
    rank-profile hybrid_semantic {
        inputs {
            query(q_chunk_emb) tensor<float>(x[384])
            query(q_question_emb) tensor<float>(x[384])
        }
        rank-properties {
            bm25(text_raw).averageFieldLength: 180
        }
        first-phase {
            expression {
                closeness(field, chunk_embedding) * 0.6 +
                closeness(field, questions_embeddings) * 0.25 +
                bm25(text_raw) * 0.15
            }
        }
        second-phase {
            expression: firstPhase
            rerank-count: 50
        }
    }



    # Lexical-heavy profile.
    rank-profile hybrid_lexical {
        inputs {
            query(q_chunk_emb) tensor<float>(x[384])
            query(q_question_emb) tensor<float>(x[384])
        }
        rank-properties {
            bm25(text_raw).averageFieldLength: 180
        }
        first-phase {
            expression {
                closeness(field, chunk_embedding) * 0.22 +
                closeness(field, questions_embeddings) * 0.08 +
                bm25(text_raw) * 0.7
            }
        }
        second-phase {
            expression: firstPhase
            rerank-count: 50
        }
    }


}
