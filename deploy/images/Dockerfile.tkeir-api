# Thin image on shared tkeir-lib (bake/compose named context).
# syntax=docker/dockerfile:1.4
FROM tkeir-lib

ARG VERSION=0.0.0-dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
ARG MODEL_MODE=fetch

USER root
ENV TKEIR_SERVICE=tkeir-api \
    RAG_HOST=0.0.0.0 \
    RAG_PORT=8090 \
    MODEL_MODE=${MODEL_MODE}

# Optional: bake HuggingFace reranker into /models (MODEL_MODE=baked).
RUN if [ "${MODEL_MODE}" = "baked" ]; then \
      mkdir -p /models && \
      /opt/tkeir/.venv/bin/python -c \
        "from sentence_transformers import CrossEncoder; \
         CrossEncoder('BAAI/bge-reranker-v2-m3'); \
         print('baked BAAI/bge-reranker-v2-m3')" && \
      chown -R 10001:10001 /models; \
    else \
      mkdir -p /models && echo "fetch" > /models/.mode && chown -R 10001:10001 /models; \
    fi

USER 10001
EXPOSE 8090

LABEL org.opencontainers.image.title="tkeir-api" \
      org.opencontainers.image.description="T-KEIR RAG FastAPI (tkeir-rag)" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/ThalesGroup/t-keir" \
      org.opencontainers.image.vendor="Thales Group" \
      org.opencontainers.image.licenses="MIT" \
      tkeir.model.mode="${MODEL_MODE}"

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${RAG_PORT}/health" || exit 1

ENTRYPOINT ["tkeir-rag"]
