# Thin image on shared tkeir-lib (bake/compose named context).
# syntax=docker/dockerfile:1.4
FROM tkeir-lib

ARG VERSION=0.0.0-dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

USER root
ENV TKEIR_SERVICE=tkeir-ingest \
    INGEST_HOST=0.0.0.0 \
    INGEST_PORT=8091 \
    INGEST_ROOT=/var/tkeir/ingest

RUN mkdir -p /var/tkeir/ingest \
    && chown -R 10001:10001 /var/tkeir/ingest

USER 10001
EXPOSE 8091

LABEL org.opencontainers.image.title="tkeir-ingest" \
      org.opencontainers.image.description="T-KEIR document ingest FastAPI" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/ThalesGroup/t-keir" \
      org.opencontainers.image.vendor="Thales Group" \
      org.opencontainers.image.licenses="MIT"

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${INGEST_PORT}/health" || exit 1

ENTRYPOINT ["tkeir-ingest"]
