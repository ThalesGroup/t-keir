<services version="1.0">
  <admin version="2.0">
    <adminserver hostalias="node1" />
  </admin>

  <container id="default" version="1.0">
    <document-api />
    <search />
    <http>
      <server id="default" port="8080" />
    </http>
  </container>

  <!-- Streaming mode: per-user (group) document spaces.
       Document ids MUST use g=<user_space>:… and queries MUST set
       streaming.groupname. See docs/tools/vespa_rag.md. -->
  <content id="content" version="1.0">
    <redundancy>1</redundancy>
    <documents>
      <document type="tkeir_document" mode="streaming" />
      <document type="chunk" mode="streaming" />
    </documents>
    <nodes>
      <node distribution-key="0" hostalias="node1" />
    </nodes>
  </content>
</services>
