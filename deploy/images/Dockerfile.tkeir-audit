# Thin image on shared tkeir-lib (bake/compose named context).
# psycopg comes from tkeir-lib (`uv sync --group audit`).
# syntax=docker/dockerfile:1.4
FROM tkeir-lib

ARG VERSION=0.0.0-dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

USER root
ENV TKEIR_SERVICE=tkeir-audit \
    AUDIT_HOST=0.0.0.0 \
    AUDIT_PORT=8093 \
    AUDIT_WORM_ROOT=/var/tkeir/audit/worm \
    AUDIT_SUBJECT_KEYS_PATH=/var/tkeir/audit/subject_keys.db

RUN mkdir -p /var/tkeir/audit/worm /var/tkeir/audit/hot \
    && chown -R 10001:10001 /var/tkeir/audit

USER 10001
EXPOSE 8093

LABEL org.opencontainers.image.title="tkeir-audit" \
      org.opencontainers.image.description="T-KEIR audit API + WORM archiver" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}"

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${AUDIT_PORT}/health" || exit 1

ENTRYPOINT ["tkeir-audit"]
