      "publicClient": false,
      "secret": "tkeir-audit-dev-secret-change-me",
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "tkeir-governor",
      "name": "T-KEIR Governor",
      "enabled": true,
      "publicClient": false,
      "secret": "tkeir-governor-dev-secret-change-me",
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "tkeir-indexer-sa",
      "name": "Indexer service account",
      "enabled": true,
      "publicClient": false,
      "secret": "tkeir-indexer-sa-dev-secret-change-me",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["intent:index", "intent:search"]
    },
    {
      "clientId": "tkeir-ingest-batch-sa",
      "name": "Ingest batch service account",
      "enabled": true,
      "publicClient": false,
      "secret": "tkeir-ingest-batch-sa-dev-secret-change-me",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["intent:ingest", "intent:index"]
    },
    {
      "clientId": "tkeir-archiver-sa",
      "name": "Audit archiver service account",
      "enabled": true,
      "publicClient": false,
      "secret": "tkeir-archiver-sa-dev-secret-change-me",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["intent:audit.read"]
    }
  ],
