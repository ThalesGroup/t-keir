# Copy to deploy/compose/.env (never commit). Used by `make compose-up`.

IMAGE_REGISTRY=local
IMAGE_TAG=dev

# Inference — macOS: Ollama on host (Metal)
PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
LLM_MODEL=mistral-nemo
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Vespa streaming user space — Keycloak JWT preferred; auth-off uses this
VESPA_USER_SPACE=dev@tkeir

# HMI / Auth.js (AUTH_ENABLED=false keeps P0-style anonymous UI)
AUTH_ENABLED=true
AUTH_SECRET=dev-auth-secret-change-me-in-production-32b
AUTH_KEYCLOAK_ISSUER=http://localhost:8082/realms/tkeir
AUTH_URL=http://localhost:3000

# Keycloak bootstrap (dev only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=keycloak

TKEIR_ENV=dev
API_PROXY_TIMEOUT_MS=300000

# Audit (Phase 4) — enable with PROFILES=core,audit
AUDIT_SINK_MODE=dual
AUDIT_HOT_STORE_URL=postgres://audit:audit@audit-db:5432/audit
AUDIT_DB_PASSWORD=audit
AUDIT_AUTH_ENABLED=false
AUDIT_WORM_S3_ENDPOINT=http://minio:9000
AUDIT_WORM_S3_BUCKET=tkeir-worm
AUDIT_WORM_RETENTION_DAYS=30

# MinIO / objectstore (WORM + ingest buckets)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Observability (Grafana :3001)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Governor (Phase 5) — enable with PROFILES=core,governor
GOVERNOR_MODE=observe
GOVERNOR_URL=http://tkeir-governor:8094
GOVERNOR_AUTH_ENABLED=false
GOVERNOR_TOKEN_SECRET=dev-governor-token-secret-change-me

# MCP (Phase A) — enable with PROFILES=…,mcp
MCP_AUTH_ENABLED=false
MCP_DEV_TOKEN=
MCP_RAG_URL=http://tkeir-api:8090

# Agents (Phase B) — enable with PROFILES=…,agents
AGENT_ROOT=/var/tkeir/agent
# Orchestrator report-form pack (osint | enterprise)
TKEIR_AGENT_USECASE=osint

# Host workspace mount for ingest (NATO ontologies / OSINT derive-from)
# Relative to deploy/compose/; override if CORPUS_OUT is elsewhere.
# TKEIR_WORKSPACE_HOST=../../workspace

# SPIRE / SPIFFE for agents (ADR-0008) — enable with PROFILES=…,spire
SPIFFE_MODE=dev
SPIFFE_TRUST_DOMAIN=tkeir.local
SPIFFE_ID=spiffe://tkeir.local/agent/tkeir-agent
SPIFFE_ENFORCE=false
SPIFFE_AGENT_ID_PREFIX=spiffe://tkeir.local/agent/
SPIRE_TAG=1.15.2
# Optional: set manually. Prefer `make spire-up` which mints a token and restarts the agent.
# SPIRE_JOIN_TOKEN=
