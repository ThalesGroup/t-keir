
# Generated from tkeir/configs/rag.yaml via `make schemas`.
# DO NOT hand-edit — change rag.yaml and regenerate.
# Source: scripts/generate_vespa_schemas.py
schema tkeir_document {
    document tkeir_document {
        field user_space type string {
            indexing: summary | attribute
        }
        field source_doc_id type string {
            indexing: summary | attribute
        }
        field title type string {
            indexing: summary | index
            index: enable-bm25
        }
        field content type array<string> {
            indexing: summary | index
            index: enable-bm25
        }
        # Lemmatized + asciifolded upstream (TextNormalizer). Avoid double linguistics.
        # Must NOT share a fieldset with raw title/content (Vespa requires matching
        # stemming/normalizing within a fieldset).
        field title_lemmatized type string {
            indexing: summary | index
            index: enable-bm25
            stemming: none
            normalizing: none
        }
        field content_lemmatized type array<string> {
            indexing: summary | index
            index: enable-bm25
            stemming: none
            normalizing: none
        }
        field json_ld type string {
            indexing: summary
        }
        field shacl_status type string {
            indexing: summary | attribute
        }
    }

    # Raw fields: Vespa default linguistics (stemming/normalizing).
    fieldset default {
        fields: title, content
    }

    # Pre-normalized fields: linguistics disabled (consistent within this set).
    fieldset lemmatized {
        fields: title_lemmatized, content_lemmatized
    }

    rank-profile document_bm25 {
        rank-properties {
            bm25(title).averageFieldLength: 12
            bm25(title_lemmatized).averageFieldLength: 7
            bm25(content).averageFieldLength: 800
            bm25(content_lemmatized).averageFieldLength: 420
        }
        first-phase {
            expression {
                bm25(title) * 0.3 +
                bm25(title_lemmatized) * 0.2 +
                bm25(content) * 0.3 +
                bm25(content_lemmatized) * 0.2
            }
        }
    }
}
