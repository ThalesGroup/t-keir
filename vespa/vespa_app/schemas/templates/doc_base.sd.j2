{# Base document fields shared by global (index) and user (streaming). #}
{# dense_vector is declared per child: Vespa forbids overriding parent fields, #}
{# and global needs HNSW while user needs attribute-only (streaming). #}
{#
 # Retention / TTL (opt-in): doc_timestamp, freshness_ttl_seconds, pinned,
 # pin_reason, source_type. Keep-selection lives in services.xml
 # (garbage-collection) — Vespa has no schema document-expiry block.
 # Unset / null freshness_ttl_seconds ⇒ document is kept forever.
#}
schema doc_base {
    document doc_base {
        # Stable id / parent reference (e.g. beir:scifact:42 or ingest digest).
        field source_ref type string {
            indexing: summary | attribute
        }
        # Passage text (chunk body) for BM25.
        field chunk_text type string {
            indexing: summary | index
            index: enable-bm25
        }
        # Sparse / lexical BGE-M3 weights (token id → weight).
        field sparse_vector type tensor<float>(token{}) {
            indexing: summary | attribute
        }
        # Ontology / SVO-derived concept ids (Graph-RAG style).
        field ontology_concepts type array<string> {
            indexing: summary | attribute
        }
        # Unix epoch seconds when the document was authored / ingested (TTL base).
        field doc_timestamp type long {
            indexing: summary | attribute
            attribute {
                fast-search
                fast-access
            }
            rank: filter
        }
        # TTL in seconds; 0 or unset ⇒ no expiry (non-regression default).
        field freshness_ttl_seconds type int {
            indexing: summary | attribute
            attribute {
                fast-access
            }
        }
        # When true, document is never expired by GC selection.
        field pinned type bool {
            indexing: summary | attribute
            attribute {
                fast-search
                fast-access
            }
        }
        # Human-readable reason for pinning (audit / ops).
        field pin_reason type string {
            indexing: summary | attribute
        }
        # Provenance class (e.g. beir, ingest, collector, wiki).
        field source_type type string {
            indexing: summary | attribute
            attribute: fast-search
            rank: filter
        }
    }
}
