# Generated from {{ config_path }} via `make schemas`.
# DO NOT hand-edit — change rag.yaml and regenerate.
# Source: scripts/generate_vespa_schemas.py
schema chunk {
    document chunk {
        field user_space type string {
            indexing: summary | attribute
        }
        field chunk_id type string {
            indexing: summary | attribute
        }
        # Parent id string (same streaming group). Join key for document arm.
        field doc_ref type string {
            indexing: summary | attribute
        }
        # Denormalized parent key for RRF fusion without an extra fetch.
        field source_doc_id type string {
            indexing: summary | attribute
        }
        field text_raw type string {
            indexing: summary | index
            index: enable-bm25
        }
        # Streaming mode: exact nearestNeighbor (no HNSW index).
        field chunk_embedding type tensor<float>(x[{{ embedding_dim }}]) {
            indexing: attribute
            attribute { distance-metric: angular }
        }
        field questions_embeddings type tensor<float>(q{}, x[{{ embedding_dim }}]) {
            indexing: attribute
            attribute { distance-metric: angular }
        }
    }

    fieldset default {
        fields: text_raw
    }

{% for profile_name, profile in chunk_profiles.items() %}
    {% if profile_name == "hybrid_2_level" %}# Balanced hybrid (default). Weights from rag.yaml rank_profiles.chunk.
    {% elif profile_name == "hybrid_semantic" %}# Semantic-heavy profile.
    {% elif profile_name == "hybrid_lexical" %}# Lexical-heavy profile.
    {% endif %}rank-profile {{ profile_name }} {
        inputs {
            query(q_chunk_emb) tensor<float>(x[{{ embedding_dim }}])
            query(q_question_emb) tensor<float>(x[{{ embedding_dim }}])
        }
        rank-properties {
            bm25(text_raw).averageFieldLength: {{ avg_text_raw }}
        }
        first-phase {
            expression {
                closeness(field, chunk_embedding) * {{ profile.closeness_chunk_embedding }} +
                closeness(field, questions_embeddings) * {{ profile.closeness_questions_embeddings }} +
                bm25(text_raw) * {{ profile.bm25_text_raw }}
            }
        }
        second-phase {
            expression: firstPhase
            rerank-count: {{ profile.rerank_count }}
        }
    }
{% if not loop.last %}
{% endif %}
{% endfor %}
}
