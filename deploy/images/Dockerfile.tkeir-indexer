# Digests: see deploy/versions.lock.yaml (python_base).
ARG PYTHON_BASE=python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93

# ---------------------------------------------------------------------------
# Builder
# ---------------------------------------------------------------------------
FROM ${PYTHON_BASE} AS builder

ARG INSTALL_OCR=1
ENV DEBIAN_FRONTEND=noninteractive \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh \
      | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh \
    && chmod 755 /usr/local/bin/uv

WORKDIR /opt/tkeir
COPY tkeir/pyproject.toml tkeir/uv.lock tkeir/README.md ./
COPY tkeir/thot ./thot
COPY tkeir/configs ./configs
COPY tkeir/resources ./resources

# Pipeline + indexer need spaCy language models (dependency-group models).
RUN uv sync --frozen --no-dev --group models

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
FROM ${PYTHON_BASE} AS runtime

ARG VERSION=0.0.0-dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown
ARG INSTALL_OCR=1
ARG VARIANT=full

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/opt/tkeir/.venv/bin:$PATH \
    TKEIR_SERVICE=tkeir-indexer \
    TRANSFORMERS_CACHE=/tmp/transformers \
    HF_HOME=/tmp/huggingface

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates \
      $(if [ "${INSTALL_OCR}" = "1" ]; then \
           echo "tesseract-ocr tesseract-ocr-eng tesseract-ocr-fra"; \
         fi) \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 tkeir \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin tkeir \
    && mkdir -p /tmp/transformers /tmp/huggingface /data/in /data/out \
    && chown -R 10001:10001 /tmp/transformers /tmp/huggingface /data

WORKDIR /opt/tkeir
COPY --from=builder --chown=10001:10001 /opt/tkeir /opt/tkeir
COPY --chmod=755 deploy/images/entrypoint-indexer.sh /usr/local/bin/entrypoint-indexer.sh

USER 10001

LABEL org.opencontainers.image.title="tkeir-indexer" \
      org.opencontainers.image.description="T-KEIR pipeline + Vespa indexer" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/ThalesGroup/t-keir" \
      org.opencontainers.image.vendor="Thales Group" \
      org.opencontainers.image.licenses="MIT" \
      tkeir.image.variant="${VARIANT}"

ENTRYPOINT ["/usr/local/bin/entrypoint-indexer.sh"]
CMD ["help"]
