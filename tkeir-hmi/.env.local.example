# Browser-facing API base (proxied via Next.js rewrites to the FastAPI server)
NEXT_PUBLIC_API_URL=/api

# Server-side proxy target for app/api route handlers (not exposed to the browser)
API_URL=http://localhost:8090
AGENT_URL=http://localhost:8092
INGEST_URL=http://localhost:8091
GOVERNOR_URL=http://localhost:8094
OKF_URL=http://localhost:8095

# Optional: proxy timeout for long RAG/LLM requests (milliseconds)
API_PROXY_TIMEOUT_MS=300000
