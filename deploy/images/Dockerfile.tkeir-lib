# Shared Python runtime for T-KEIR services (api, ingest, mcp, agent, governor, audit).
# Built once via bake target `tkeir-lib`; service images FROM this context — do not
# re-run uv sync in each service Dockerfile.
#
# Digests: see deploy/versions.lock.yaml (python_base).
ARG PYTHON_BASE=python:3.11-slim@sha256:db3ff2e1800a8581e2c48a27c3995339d47bdf046da21c7627accd3d51053a93

# ---------------------------------------------------------------------------
# Builder — uv sync once into /opt/tkeir
# ---------------------------------------------------------------------------
FROM ${PYTHON_BASE} AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh \
      | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh \
    && chmod 755 /usr/local/bin/uv

WORKDIR /opt/tkeir
COPY tkeir/pyproject.toml tkeir/uv.lock tkeir/README.md ./
COPY tkeir/thot ./thot
COPY tkeir/configs ./configs
COPY tkeir/resources ./resources
# Dataset agent/workflow packs (OSINT personas, llm_wiki, …) — not full corpora.
COPY datasets/osint/agents ./packs/osint/agents
COPY datasets/osint/workflows ./packs/osint/workflows
COPY datasets/osint/agent_orchestrator.yaml ./packs/osint/agent_orchestrator.yaml
COPY datasets/enterprise/agent_orchestrator.yaml ./packs/enterprise/agent_orchestrator.yaml

# audit (psycopg) + models (spaCy) are shared so ingest can run the pipeline
# in-container without a second sync. Indexer still builds its own tree.
RUN uv sync --frozen --no-dev --group audit --group models \
    && find /opt/tkeir/.venv -type d \( -name tests -o -name test -o -name __pycache__ \) \
         -print0 | xargs -0 rm -rf \
    && find /opt/tkeir/.venv -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete

# ---------------------------------------------------------------------------
# Runtime base — non-root user + venv; no service ENTRYPOINT
# ---------------------------------------------------------------------------
FROM ${PYTHON_BASE} AS runtime

ARG VERSION=0.0.0-dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH=/opt/tkeir/.venv/bin:$PATH \
    TRANSFORMERS_CACHE=/tmp/transformers \
    HF_HOME=/tmp/huggingface

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 tkeir \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin tkeir \
    && mkdir -p /tmp/transformers /tmp/huggingface /models \
    && chown -R 10001:10001 /tmp/transformers /tmp/huggingface /models

WORKDIR /opt/tkeir
COPY --from=builder --chown=10001:10001 /opt/tkeir /opt/tkeir

USER 10001

LABEL org.opencontainers.image.title="tkeir-lib" \
      org.opencontainers.image.description="Shared T-KEIR Python runtime (venv + thot)" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/ThalesGroup/t-keir" \
      org.opencontainers.image.vendor="Thales Group" \
      org.opencontainers.image.licenses="MIT"
