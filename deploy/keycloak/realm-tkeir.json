{
  "realm": "tkeir",
  "enabled": true,
  "displayName": "T-KEIR",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "sslRequired": "external",
  "roles": {
    "realm": [
      { "name": "tkeir-user", "description": "Query / RAG" },
      { "name": "tkeir-operator", "description": "Ingest and index" },
      { "name": "tkeir-auditor", "description": "Read-only audit" },
      {
        "name": "tkeir-admin",
        "description": "Oversight panel",
        "composite": true,
        "composites": {
          "realm": ["tkeir-user", "tkeir-operator", "tkeir-auditor"]
        }
      }
    ]
  },
  "clientScopes": [
    {
      "name": "intent:search",
      "description": "Declared intent: search/RAG",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "intent:ingest",
      "description": "Declared intent: ingest",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "intent:index",
      "description": "Declared intent: index",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "intent:delete",
      "description": "Declared intent: delete",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "intent:audit.read",
      "description": "Declared intent: audit read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "intent:admin.override",
      "description": "Declared intent: admin override",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "tkeir-hmi",
      "name": "T-KEIR HMI",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:3000",
      "baseUrl": "http://localhost:3000",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://127.0.0.1:3000/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "intent:search"
      ],
      "optionalClientScopes": [
        "intent:ingest",
        "intent:index",
        "intent:delete",
        "intent:audit.read",
        "intent:admin.override",
        "offline_access"
      ]
    },
    {
      "clientId": "tkeir-api",
      "name": "T-KEIR RAG API",
      "enabled": true,
      "publicClient": false,
      "secret": "tkeir-api-dev-secret-change-me",
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "tkeir-ingest",
      "name": "T-KEIR Ingest",
      "enabled": true,
      "publicClient": false,
      "secret": "tkeir-ingest-dev-secret-change-me",
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "tkeir-audit",
      "name": "T-KEIR Audit",
      "enabled": true,
      "publicClient": false,
      "secret": "tkeir-audit-dev-secret-change-me",
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "tkeir-governor",
      "name": "T-KEIR Governor",
      "enabled": true,
      "publicClient": false,
      "secret": "tkeir-governor-dev-secret-change-me",
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "tkeir-indexer-sa",
      "name": "Indexer service account",
      "enabled": true,
      "publicClient": false,
      "secret": "tkeir-indexer-sa-dev-secret-change-me",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["intent:index", "intent:search"]
    },
    {
      "clientId": "tkeir-ingest-batch-sa",
      "name": "Ingest batch service account",
      "enabled": true,
      "publicClient": false,
      "secret": "tkeir-ingest-batch-sa-dev-secret-change-me",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["intent:ingest", "intent:index"]
    },
    {
      "clientId": "tkeir-archiver-sa",
      "name": "Audit archiver service account",
      "enabled": true,
      "publicClient": false,
      "secret": "tkeir-archiver-sa-dev-secret-change-me",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["intent:audit.read"]
    }
  ],
  "users": [
    {
      "username": "demo-user",
      "enabled": true,
      "email": "demo-user@tkeir",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "demo-user",
          "temporary": false
        }
      ],
      "realmRoles": ["tkeir-user"]
    },
    {
      "username": "demo-auditor",
      "enabled": true,
      "email": "demo-auditor@tkeir",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Auditor",
      "credentials": [
        {
          "type": "password",
          "value": "demo-auditor",
          "temporary": false
        }
      ],
      "realmRoles": ["tkeir-auditor", "tkeir-user"]
    },
    {
      "username": "demo-admin",
      "enabled": true,
      "email": "demo-admin@tkeir",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "demo-admin",
          "temporary": false
        }
      ],
      "realmRoles": ["tkeir-admin"]
    }
  ]
}
