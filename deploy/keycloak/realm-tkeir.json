{
  "realm": "tkeir",
  "enabled": true,
  "displayName": "T-KEIR",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "sslRequired": "none",
  "attributes": {
    "unmanagedAttributePolicy": "ENABLED"
  },
  "roles": {
    "realm": [
      { "name": "tkeir-user", "description": "Query / RAG" },
      { "name": "tkeir-operator", "description": "Ingest and index" },
      { "name": "tkeir-auditor", "description": "Read-only audit" },
      {
        "name": "tkeir-admin",
        "description": "Oversight panel",
        "composite": true,
        "composites": {
          "realm": ["tkeir-user", "tkeir-operator", "tkeir-auditor"]
        }
      },
      {
        "name": "c2-j2-analyst",
        "description": "NATO C2 J2 analyst persona"
      },
      {
        "name": "c2-moc-watch",
        "description": "NATO C2 MOC watch persona"
      },
      {
        "name": "c2-j2x-humint",
        "description": "NATO C2 J2X HUMINT persona"
      },
      {
        "name": "c2-ctf-commander",
        "description": "NATO C2 CTF commander persona"
      },
      {
        "name": "c2-admin",
        "description": "NATO C2 admin persona",
        "composite": true,
        "composites": {
          "realm": ["tkeir-admin", "tkeir-user", "tkeir-operator", "tkeir-auditor"]
        }
      }
    ]
  },
  "clientScopes": [
    {
      "name": "intent:search",
      "description": "Declared intent: search/RAG",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "intent:ingest",
      "description": "Declared intent: ingest",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "intent:index",
      "description": "Declared intent: index",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "intent:delete",
      "description": "Declared intent: delete",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "intent:audit.read",
      "description": "Declared intent: audit read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "intent:admin.override",
      "description": "Declared intent: admin override",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "intent:collect",
      "description": "Declared intent: web collect",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "tkeir-cli",
      "name": "T-KEIR CLI (password grant for demos)",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "clearance",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "clearance",
            "claim.name": "clearance",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "roles",
        "intent:search",
        "intent:ingest",
        "intent:index",
        "intent:collect"
      ]
    },
    {
      "clientId": "tkeir-hmi",
      "name": "T-KEIR HMI",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:3000",
      "baseUrl": "http://localhost:3000",
      "redirectUris": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000",
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://127.0.0.1:3000/*"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "clearance",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "clearance",
            "claim.name": "clearance",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "intent:search"
      ],
      "optionalClientScopes": [
        "intent:ingest",
        "intent:index",
        "intent:delete",
        "intent:audit.read",
        "intent:admin.override",
        "intent:collect",
        "offline_access"
      ]
    },
    {
      "clientId": "tkeir-api",
      "name": "T-KEIR RAG API",
      "enabled": true,
      "publicClient": false,
      "secret": "tkeir-api-dev-secret-change-me",
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "tkeir-ingest",
      "name": "T-KEIR Ingest",
      "enabled": true,
      "publicClient": false,
      "secret": "tkeir-ingest-dev-secret-change-me",
