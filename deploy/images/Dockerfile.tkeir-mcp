# Thin image on shared tkeir-lib (bake/compose named context).
# syntax=docker/dockerfile:1.4
FROM tkeir-lib

ARG VERSION=0.0.0-dev
ARG GIT_COMMIT=unknown
ARG BUILD_DATE=unknown

ENV TKEIR_SERVICE=tkeir-mcp \
    MCP_HOST=0.0.0.0 \
    MCP_PORT=8093

EXPOSE 8093

LABEL org.opencontainers.image.title="tkeir-mcp" \
      org.opencontainers.image.description="T-KEIR MCP read-only tool server" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="https://github.com/ThalesGroup/t-keir" \
      org.opencontainers.image.vendor="Thales Group" \
      org.opencontainers.image.licenses="MIT"

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${MCP_PORT}/health" || exit 1

ENTRYPOINT ["tkeir-mcp"]
